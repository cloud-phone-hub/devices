;; vendor.qti.diaghal（高通 diag HAL，自研实现）的 SELinux 片段，由
;; 07_build_vendor 步骤 6 以 marker
;;（;; cdh-patch-begin: vendor_sepolicy.cil@vendor.qti.diaghal）
;; 整块并入装配树 /vendor/etc/selinux/vendor_sepolicy.cil；同一 marker 重复执行幂等。
;;
;; 为什么在模块层：域、可执行标签、服务名标签都是这个 HAL 自身的契约，换机型不重写。
;; 机型层原本只有 hal_idiag_service 的类型与 system_server / vendor_dpmd 的 find
;; 授权（"无实体的占位标签"），自研实体接入后类型与授权搬到这里，机型层同批删除
;;（重复 (type …) 会让 secilc Failed to resolve → init InitFatalReboot）。
;;
;; 类型名：服务名沿原厂 vendor_hal_diaghal_service；域/exec 原厂没有（Idiag 由
;; vendor_diag-router 注册，原厂只有 /vendor/bin/diag-router 的
;; vendor_diag-router_exec），本云沿用 servicetracker 先例的 QTI 风格
;; vendor_hal_diaghal_default / _default_exec。
;;
;; 与原厂的差异：原厂 diag 还有 /dev/diag（vendor_diag_device）、
;; /dev/mhi_*_pipe_4（vendor_mhi_diag_device）、/data/vendor/diag_logs
;;（mdlog_vendor_data_file）、ssr/cnss diag 工具与 capabilities KILL —— 全是要访问
;; 本机 diag 驱动与高通固件才需要的。本云实现不 open 任何设备节点、不映射 fd，
;; 故一条都不搬；将来真接日志采集再从原厂策略取回，并按判据留在机型层
;;（路径绑本机 PCIe/MHI 拓扑）。
;; 平台域一律用 {{vers}} 占位，由构建阶段按 plat_sepolicy_vers.txt 替换。

;; ---- 1) 域与可执行标签 ----
;; 进程域必须归入 domain 属性，否则 init 的 setexeccon 报 EINVAL、服务 fork 后 signal 6
;;（同 vendor.meizu.hardware.aw_light 的说明）。
(type vendor_hal_diaghal_default)
(typeattributeset domain (vendor_hal_diaghal_default))
(roletype object_r vendor_hal_diaghal_default)
(type vendor_hal_diaghal_default_exec)
(roletype object_r vendor_hal_diaghal_default_exec)

;; ---- 2) init 启动链 ----
;; rc 的 seclabel 让 init 显式换域；exec 标签由 07 步骤 6b 按同一行派生
;;（/(vendor|system/vendor)/bin/hw/vendor.qti.diaghal-service）。
(allow init_{{vers}} vendor_hal_diaghal_default_exec (file (read getattr map execute open entrypoint)))
(allow init_{{vers}} vendor_hal_diaghal_default (process (transition noatsecure siginh rlimitinh)))
(allow vendor_hal_diaghal_default vendor_hal_diaghal_default_exec (file (read getattr map execute open entrypoint)))
(dontaudit init_{{vers}} vendor_hal_diaghal_default (process (noatsecure)))

;; ---- 3) AIDL 服务注册与查询 ----
;; 服务名标签走同目录 vendor_service_contexts。
(type vendor_hal_diaghal_service)
(roletype object_r vendor_hal_diaghal_service)
(typeattributeset service_manager_type (vendor_hal_diaghal_service))
(allow vendor_hal_diaghal_default servicemanager_{{vers}} (binder (call transfer)))
(allow vendor_hal_diaghal_default vendor_hal_diaghal_service (service_manager (add find)))
;; 客户端侧用 domain 通配（perf2 先例）：只授「名字可见」，真正调用还要 binder call。
(allow domain vendor_hal_diaghal_service (service_manager (find)))

;; ---- 4) Binder 域间调用 ----
;; 调用方是 system_server（DiagManagerService）与少数厂商守护进程；open 会把客户端的
;; IIdiagcallback binder 传进来，故按双向授权（与基座 binder_call 宏的产出同款）。
(allow system_server_{{vers}} vendor_hal_diaghal_default (binder (call)))
(allow vendor_hal_diaghal_default system_server_{{vers}} (binder (call)))
