# 常驻蜂窝 IMS 承载网与运营商配置守护：sys.boot_completed=1 后以 system(1000) 身份运行，
# 兼具 ACCESS_CONTENT_PROVIDERS_EXTERNALLY / WRITE_APN_SETTINGS / MODIFY_PHONE_STATE /
# CONNECTIVITY_USE_RESTRICTED_NETWORKS 权限，动态对齐荣耀/华为 opkey 与 CarrierConfig、
# 无侵入补齐预置 APN，并常驻维护 TRANSPORT_CELLULAR + NET_CAPABILITY_IMS 请求拉起 ccmni0。
service vendor.cph_ims_netmgr /system/bin/sh /vendor/bin/cph-ims-netmgr
    class late_start
    user system
    group system radio inet
    seclabel u:r:pioneer:s0
    disabled

on property:sys.boot_completed=1
    start vendor.cph_ims_netmgr
