    "sepolicy": {
      "vendor_service_contexts": "# 官方 vendor 是 A14/34.0，07 的跨代收口会删掉引用 hal_graphics_mapper_service 的行；\n# 本机系统 plat_sepolicy.cil（A16）实际声明了该类型，minigbm mapper 服务必须保留映射，\n# 否则 SurfaceFlinger 查 mapper/minigbm_upstream 落到 default_android_service 并被 SELinux 拒。\nmapper/minigbm_upstream\tu:object_r:hal_graphics_mapper_service:s0\nmapper/minigbm\tu:object_r:hal_graphics_mapper_service:s0\n"
    }
