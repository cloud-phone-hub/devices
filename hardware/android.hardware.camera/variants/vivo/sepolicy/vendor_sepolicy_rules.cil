;; camera@vivo 变体条件 SELinux 规则：
;; 放行 platform_app 查找 Vivo 扩展相机服务并调用 neuralnetworks / camera HAL。
;; @when-or declared:hal_camera3rd_service | svcctx:vendor.vivo.hardware.vivocameraprovider.IVivoCameraProvider
(allow {{pick:platform_app}} hal_camera3rd_service (service_manager (find)))
(allow {{pick:platform_app}} hal_cameralog_service (service_manager (find)))
(allow {{pick:platform_app}} hal_camera_service (service_manager (find)))
(allow {{pick:platform_app}} hal_neuralnetworks_default (binder (call transfer)))
(allow {{pick:platform_app}} hal_camera_default (binder (call transfer)))
;; @end
