;; popsicle（Xiaomi 17 Pro Max / HyperOS 3 & 4 / Android 16 / 高通 canoe）机型层 SELinux 片段。
;;
;; 由 07_build_vendor 以 marker（;; cdh-patch-begin: vendor_sepolicy.cil）整块追加到
;; 装配树 /vendor/etc/selinux/vendor_sepolicy.cil；同一 marker 重复执行幂等。
;; 平台类型按 vendor CIL 约定用 {{vers}} 影子名，构建阶段替换成基底 plat vers。
;;
;; ---- 1) FRP 承载块设备 ----
(allow system_server_{{vers}} misc_block_device_{{vers}} (blk_file (open read write append getattr ioctl map lock)))

;; ---- 2) pioneer (cph service_daemon) 与 system_server binder 双向回调及 sysfs/sysfs_thermal 读取 ----
(allow pioneer system_server_{{vers}} (binder (call transfer)))
(allow system_server_{{vers}} pioneer (binder (call transfer)))
(allow pioneer system_server_{{vers}} (fd (use)))
(allow system_app_{{vers}} sysfs_{{vers}} (file (open read getattr)))
(allow system_app_{{vers}} sysfs_thermal_{{vers}} (dir (read getattr open search)))
(allow system_app_{{vers}} sysfs_thermal_{{vers}} (file (read getattr open)))
(allow system_app_{{vers}} sysfs_thermal_{{vers}} (lnk_file (read getattr)))

;; ---- 3) perf2 HAL (hal_sensors_default) binder 双向调用、composer3 / SurfaceFlinger / system_server / platform_app 服务绑定与高频缺失硬件审计静默 ----
(allow domain hal_sensors_default (binder (call transfer)))
(allow hal_sensors_default domain (binder (call transfer)))
(allow hal_graphics_composer_default vendor_default_prop_{{vers}} (file (open read getattr map)))
(allow surfaceflinger_{{vers}} vendor_default_prop_{{vers}} (file (open read getattr map)))
(allow hal_neuralnetworks_default hal_touchfeature_xiaomi_service (service_manager (add find)))
(allow system_server_{{vers}} vendor_hal_displayfeature_xiaomi_service (service_manager (find)))
(allow platform_app_{{vers}} sysfs_thermal_{{vers}} (dir (open read getattr search)))
(dontaudit domain default_android_service_{{vers}} (service_manager (find)))
(dontaudit platform_app_{{vers}} hal_mtdservice_service (service_manager (find)))
(dontaudit cameraserver_{{vers}} cameraserver_{{vers}} (capability (fowner)))
(dontaudit platform_app_{{vers}} proc_max_map_count_{{vers}} (file (open read getattr)))
(dontaudit domain vendor_dpmtcm_socket_{{vers}} (sock_file (write)))
(dontaudit audioserver_{{vers}} vendor_audio_prop (file (open read getattr map)))
(dontaudit audioserver_{{vers}} vendor_default_prop_{{vers}} (file (open read getattr map)))
(dontaudit pioneer system_prop_{{vers}} (file (open read getattr map)))
(dontaudit pioneer default_prop_{{vers}} (file (open read getattr map)))
(dontaudit pioneer kmsg_device_{{vers}} (chr_file (open write getattr)))
