# CDH setup for OnePlus Ace 3 (PJE110):
# 1. 创建 /data/vendor/nfc 与 /data/nfc 目录，避免 com.android.nfc 首次写入时触发 AVC；
# 2. 开机后禁用 workloadclassifier（规避 QPerformance JNI 崩溃循环）与 vendor.qti.iwlan。
on post-fs-data
    mkdir /data/vendor/nfc 0770 nfc nfc
    mkdir /data/nfc 0770 nfc nfc

service cph_pje110_setup /system/bin/sh /vendor/bin/cph_pje110_setup.sh
    class late_start
    user root
    group root system
    seclabel u:r:pioneer:s0
    oneshot
    disabled

on property:sys.user.0.ce_available=true
    start cph_pje110_setup

on property:sys.boot_completed=1
    start cph_pje110_setup
