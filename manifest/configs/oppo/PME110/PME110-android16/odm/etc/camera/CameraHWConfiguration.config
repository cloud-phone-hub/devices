    color_warm_cyan_hdr = /odm/etc/camera/LUT_17/color_warm_cyan_HLG.cube

    # Tone LUTs SDR/HDR
    tone_base_sdr = /odm/etc/camera/LUT_17/tone_base_SRGB.cube
