<?xml version="1.0" encoding="utf-8" ?>
<!--
  CDH Codec2 V4L2 硬件编解码能力声明（02_prepare 自动生成）。
  AOSP Codec2InfoBuilder 依赖 <Limit name="size" .../> 为 c2.v4l2.* 构造 size-range，
  缺失时 MediaCodecList::codecHandlesFormat 会跳过 c2.v4l2.* 组件。
-->
<MediaCodecs>
    <Decoders>
        <MediaCodec name="c2.v4l2.avc.decoder" type="video/avc">
            <Limit name="size" min="2x2" max="4096x4096" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="frame-rate" range="1-240" />
            <Limit name="measured-frame-rate-320x240" range="240-480" />
            <Limit name="measured-frame-rate-720x480" range="240-480" />
            <Limit name="measured-frame-rate-1280x720" range="180-360" />
            <Limit name="measured-frame-rate-1920x1080" range="120-240" />
            <Limit name="measured-frame-rate-3840x2160" range="60-120" />
            <Feature name="adaptive-playback" />
            <Feature name="can-swap-width-height" />
        </MediaCodec>
        <MediaCodec name="c2.v4l2.hevc.decoder" type="video/hevc">
            <Limit name="size" min="2x2" max="4096x4096" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="frame-rate" range="1-240" />
            <Limit name="measured-frame-rate-320x240" range="240-480" />
            <Limit name="measured-frame-rate-720x480" range="240-480" />
            <Limit name="measured-frame-rate-1280x720" range="180-360" />
            <Limit name="measured-frame-rate-1920x1080" range="120-240" />
            <Limit name="measured-frame-rate-3840x2160" range="60-120" />
            <Feature name="adaptive-playback" />
            <Feature name="can-swap-width-height" />
        </MediaCodec>
    </Decoders>
    <Encoders>
        <MediaCodec name="c2.v4l2.avc.encoder" type="video/avc">
            <Limit name="size" min="32x32" max="4096x4096" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="frame-rate" range="1-240" />
            <Limit name="measured-frame-rate-320x240" range="240-480" />
            <Limit name="measured-frame-rate-720x480" range="180-360" />
            <Limit name="measured-frame-rate-1280x720" range="120-240" />
            <Limit name="measured-frame-rate-1920x1080" range="60-120" />
            <Limit name="measured-frame-rate-3840x2160" range="30-60" />
            <Limit name="bitrate" range="1-40000000" />
            <Feature name="bitrate-modes" value="VBR,CBR" />
            <Feature name="can-swap-width-height" />
        </MediaCodec>
    </Encoders>
</MediaCodecs>
