<?xml version="1.0" encoding="utf-8"?>
<!-- Pixel 6 (google/oriole) Codec2 Store 实例与组件登记（rank=1 确保软解优先，且保证每个 store 非空） -->
<media-c2-config>
    <instance binary="google.hardware.media.c2@1.0-service" store="default1"/>
    <instance binary="samsung.hardware.media.c2@1.2-service" store="default1"/>
    <instance binary="vendor.dolby.media.c2@1.0-service" store="default9"/>
    <component store="default1" name="c2.google.av1.decoder" kind="decoder" domain="video" media-type="video/av01" rank="1" aliases="" profiles="" levels=""/>
    <component store="default1" name="c2.google.av1.decoder.secure" kind="decoder" domain="video" media-type="video/av01" rank="1" aliases="" profiles="" levels=""/>
    <component store="default9" name="c2.dolby.eac3.decoder" kind="decoder" domain="audio" media-type="audio/eac3" rank="1" aliases="" profiles="" levels=""/>
</media-c2-config>
