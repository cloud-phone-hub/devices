# Honor MagicOS hwfactoryinterface 服务可执行标签
# @when-file bin/hw/vendor.honor.hardware.hwfactoryinterface-service
/(vendor|system/vendor)/bin/hw/vendor\.honor\.hardware\.hwfactoryinterface-service u:object_r:hal_hwfactoryinterface_default_exec:s0
# @end
# @when-file bin/hw/vendor.honor.hardware.hwfactoryinterface@1.1-service
/(vendor|system/vendor)/bin/hw/vendor\.honor\.hardware\.hwfactoryinterface@1\.1-service u:object_r:hal_hwfactoryinterface_default_exec:s0
# @end
