# engine/vendor 自研 authsecret HAL（虚拟 HAL）：云机没有安全硬件，服务注册
# android.hardware.authsecret.IAuthSecret/default，派生密钥返回失败。
service vendor.authsecret-default /vendor/bin/hw/android.hardware.authsecret-service
    class hal
    user system
    group system
    seclabel u:r:hal_authsecret_default:s0
    interface aidl android.hardware.authsecret.IAuthSecret/default
