;; cdh gold：Widevine AIDL HAL（com.google.android.widevine APEX）SELinux 补丁。
;; 由 07_build_vendor 追加到 /vendor/etc/selinux/vendor_sepolicy.cil 末尾（机型层，
;; marker 为 `;; vendor_sepolicy.cil`）。
;;
;; 背景：APEX 自带 rc（service vendor.drm-widevine-hal）、VINTF 片段与 /apex 内
;; 二进制，基座 lineage vendor 策略只缺 hal_drm_widevine 域与 hal_drm_widevine_exec
;; 标签类型 —— 开机串口实测：
;;   SELinux: Context u:object_r:hal_drm_widevine_exec:s0 is not valid (left unmapped)
;;   init: Could not start service 'vendor.drm-widevine-hal' as part of class 'hal':
;;         File /apex/.../android.hardware.drm-service.widevine(labeled
;;         "u:object_r:unlabeled:s0") has incorrect label or no domain transition
;; 即 APEX 镜像里烘好的 exec 标签因类型未声明而 unmapped，init 拒绝启动服务。
;;
;; 规则来源：同平台（MTK Android 15，plat vers 202404）真机
;; /vendor/etc/selinux/vendor_sepolicy.cil 的 hal_drm_widevine 段逐条对齐，去掉云机
;; 不存在的设备节点（/dev/drm_wv、kisd、gz、vcu、teeperf、kb/dkb 块设备）与 TEE
;; 客户端属性；/data/vendor/mediadrm 在 gold 的标签是 vendor_data_file（真机是
;; mediadrm_vendor_data_file，本盘策略未声明该类型）。
;; 平台类型按 vendor CIL 约定用 {{vers}} 影子名，构建阶段替换。

;; ---- 类型与属性 ----
(type hal_drm_widevine)
(roletype object_r hal_drm_widevine)
(type hal_drm_widevine_exec)
(roletype object_r hal_drm_widevine_exec)
(typeattributeset domain (hal_drm_widevine))
(typeattributeset halserverdomain (hal_drm_widevine))
(typeattributeset halclientdomain (hal_drm_widevine))
(typeattributeset hal_drm (hal_drm_widevine))
(typeattributeset hal_drm_server (hal_drm_widevine))
(typeattributeset hal_allocator_client (hal_drm_widevine))
(typeattributeset file_type (hal_drm_widevine_exec))
(typeattributeset exec_type (hal_drm_widevine_exec))
(typeattributeset vendor_file_type (hal_drm_widevine_exec))

;; ---- 启动链：rc 不带 seclabel，靠 APEX 内文件标签换域 ----
(allow init_{{vers}} hal_drm_widevine_exec (file (read getattr map execute open)))
(allow init_{{vers}} hal_drm_widevine (process (transition siginh rlimitinh)))
(dontaudit init_{{vers}} hal_drm_widevine (process (noatsecure)))
(typetransition init_{{vers}} hal_drm_widevine_exec process hal_drm_widevine)
(allow hal_drm_widevine hal_drm_widevine_exec (file (read getattr map execute open entrypoint)))

;; ---- APEX 内库（liboemcrypto.so 等，标签 vendor_file）只读映射 ----
(allow hal_drm_widevine vendor_file_{{vers}} (file (read getattr map open)))

;; ---- vndbinder 注册（AServiceManager_addService 走 vndservicemanager）----
(allow hal_drm_widevine vndbinder_device_{{vers}} (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(allow hal_drm_widevine vndservicemanager_{{vers}} (binder (call transfer)))
(allow vndservicemanager_{{vers}} hal_drm_widevine (dir (search)))
(allow vndservicemanager_{{vers}} hal_drm_widevine (file (read map open)))
(allow vndservicemanager_{{vers}} hal_drm_widevine (process (getattr)))

;; ---- 服务注册：AIDL HAL 实际向 servicemanager 注册，服务名未在
;; vendor_service_contexts 映射，落 default_android_service 标签。
;; 缺这两条时 AServiceManager_addService 返回 -1，进程 CHECK 失败 abort
;; （实测 avc: denied { add } ... tclass=service_manager permissive=0）。
(allow hal_drm_widevine servicemanager_{{vers}} (binder (call transfer)))
(allow hal_drm_widevine hal_drm_service_{{vers}} (service_manager (add find)))
(allow hal_drm_widevine mediaserver_service_{{vers}} (service_manager (add find)))
(allow hal_drm_widevine default_android_service_{{vers}} (service_manager (add find)))
(allow hal_drm_widevine pioneer (binder (call transfer)))
(allow pioneer hal_drm_widevine (binder (call transfer)))

;; ---- 安全缓冲/分配器 fd 传递 ----
(allow hal_drm_widevine hal_allocator_server (fd (use)))
(allow hal_drm_widevine mediacodec (fd (use)))
(allow hal_drm_widevine base_typeattr_232_{{vers}} (fd (use)))

;; ---- /data/vendor/mediadrm（APEX rc 里 mkdir 0770 media mediadrm）----
(allow hal_drm_widevine vendor_data_file_{{vers}} (dir (ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow hal_drm_widevine vendor_data_file_{{vers}} (file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))

;; ---- 诊断与只读设备树 ----
(allow hal_drm_widevine debugfs_tracing_{{vers}} (file (write)))
(allow hal_drm_widevine mnt_vendor_file_{{vers}} (dir (search)))
(allow hal_drm_widevine block_device_{{vers}} (dir (search)))

;; ---- crash_dump / surfaceflinger 宽松模式（机型层，仅 gold）----
;; 原先由内核侧 CDH_PIONEER_PERMISSIVE（`permissive_map` 强标三型）承担，2026-11-02 起内核补丁
;; 全部移除，permissive 改由策略表达：
;;   - pioneer：在模块层 devices/hardware/android.service.daemon/sepolicy/vendor_sepolicy.cil
;;     （四机型共用，带 type/roletype/domain，本文件不能重复声明）；
;;   - crash_dump / surfaceflinger：平台域，gold 的云机镜像没有 su，vendor 策略又拒
;;     crash_dump -> system_server/surfaceflinger 的 ptrace，debuggerd 收不到 native 回溯栈；
;;     surfaceflinger 在 bring-up 阶段需要放行试错。两者只在 gold 放宽，23.2 线的机型
;;     （m22 / cph2797 / ss9380）历史上就没标过，不要跟着加。
;; 两个类型都在 plat_sepolicy.cil 里以裸名声明（crash_dump 第 1524 行、surfaceflinger 第 4153 行，
;; gold 的 plat 版本），运行期 init 合并时直接可见，不需要 {{vers}} 影子名。
;; 去掉这两条等同于「放弃 debuggerd 回溯 + SF 回到 enforcing」，不影响开机。
(typepermissive crash_dump)
(typepermissive surfaceflinger)

;; ---- cameraserver 查询 mtk_hal_atms_service 放行（避免每次 Camera.open 因 avc find 拒绝阻塞 5s）----
(allow cameraserver_{{vers}} mtk_hal_atms_service (service_manager (find)))

;; ---- FRP 承载块设备（/dev/block/by-name/frp -> /dev/block/vda3，供 PersistentDataBlockService 与 OemLockService 读写）----
(allow system_server_{{vers}} misc_block_device_{{vers}} (blk_file (open read write append getattr ioctl map lock)))

;; ---- 厂商覆盖文件类型补齐（消除 /vendor/etc/md 与 /vendor/firmware/connfem.cfg 的 unlabeled:s0）----
(type vendor_etc_md_file)
(roletype object_r vendor_etc_md_file)
(type connsys_vendor_file)
(roletype object_r connsys_vendor_file)
(typeattributeset file_type (vendor_etc_md_file connsys_vendor_file))
(typeattributeset vendor_file_type (vendor_etc_md_file connsys_vendor_file))

;; ---- MTK 公开只读平台属性类型（对齐真机 vendor_property_contexts，使普通 App 与 vendor_init 正常读写）----
(type vendor_mtk_default_prop)
(roletype object_r vendor_mtk_default_prop)
(type vendor_mtk_soc_prop)
(roletype object_r vendor_mtk_soc_prop)
(type vendor_mtk_camera_prop)
(roletype object_r vendor_mtk_camera_prop)
(type vendor_mtk_ro_aee_prop)
(roletype object_r vendor_mtk_ro_aee_prop)
(type vendor_mtk_emmc_support_prop)
(roletype object_r vendor_mtk_emmc_support_prop)
(typeattributeset property_type (vendor_mtk_default_prop vendor_mtk_soc_prop vendor_mtk_camera_prop vendor_mtk_ro_aee_prop vendor_mtk_emmc_support_prop))
(typeattributeset vendor_property_type (vendor_mtk_default_prop vendor_mtk_soc_prop vendor_mtk_camera_prop vendor_mtk_ro_aee_prop vendor_mtk_emmc_support_prop))
(typeattributeset vendor_public_property_type (vendor_mtk_default_prop vendor_mtk_soc_prop vendor_mtk_camera_prop vendor_mtk_ro_aee_prop vendor_mtk_emmc_support_prop))
(allow vendor_init_{{vers}} vendor_mtk_default_prop (property_service (set)))
(allow vendor_init_{{vers}} vendor_mtk_default_prop (file (read getattr map open)))
(allow vendor_init_{{vers}} vendor_mtk_soc_prop (property_service (set)))
(allow vendor_init_{{vers}} vendor_mtk_soc_prop (file (read getattr map open)))
(allow vendor_init_{{vers}} vendor_mtk_camera_prop (property_service (set)))
(allow vendor_init_{{vers}} vendor_mtk_camera_prop (file (read getattr map open)))
(allow vendor_init_{{vers}} vendor_mtk_ro_aee_prop (property_service (set)))
(allow vendor_init_{{vers}} vendor_mtk_ro_aee_prop (file (read getattr map open)))
(allow vendor_init_{{vers}} vendor_mtk_emmc_support_prop (property_service (set)))
(allow vendor_init_{{vers}} vendor_mtk_emmc_support_prop (file (read getattr map open)))
(allow appdomain vendor_mtk_default_prop (file (read getattr map open)))
(allow appdomain vendor_mtk_soc_prop (file (read getattr map open)))
(allow appdomain vendor_mtk_camera_prop (file (read getattr map open)))
(allow appdomain vendor_mtk_ro_aee_prop (file (read getattr map open)))
(allow appdomain vendor_mtk_emmc_support_prop (file (read getattr map open)))
(allow shell_{{vers}} vendor_mtk_default_prop (file (read getattr map open)))
(allow shell_{{vers}} vendor_mtk_soc_prop (file (read getattr map open)))
(allow shell_{{vers}} vendor_mtk_camera_prop (file (read getattr map open)))
(allow shell_{{vers}} vendor_mtk_ro_aee_prop (file (read getattr map open)))
(allow shell_{{vers}} vendor_mtk_emmc_support_prop (file (read getattr map open)))
(allow system_server_{{vers}} vendor_mtk_default_prop (file (read getattr map open)))
(allow system_server_{{vers}} vendor_mtk_soc_prop (file (read getattr map open)))
(allow system_server_{{vers}} vendor_mtk_camera_prop (file (read getattr map open)))
(allow system_server_{{vers}} vendor_mtk_ro_aee_prop (file (read getattr map open)))
(allow system_server_{{vers}} vendor_mtk_emmc_support_prop (file (read getattr map open)))

;; ---- 小米音频只读平台属性类型（对齐真机 vendor_property_contexts ro.vendor.audio.* -> vendor_misound_ro_prop，使 AudioService 启用 17 阶 200% 大音量与 odmvolume）----
(type vendor_misound_ro_prop)
(roletype object_r vendor_misound_ro_prop)
(typeattributeset property_type (vendor_misound_ro_prop))
(typeattributeset vendor_property_type (vendor_misound_ro_prop))
(typeattributeset vendor_public_property_type (vendor_misound_ro_prop))
(allow vendor_init_{{vers}} vendor_misound_ro_prop (property_service (set)))
(allow vendor_init_{{vers}} vendor_misound_ro_prop (file (read getattr map open)))
(allow appdomain vendor_misound_ro_prop (file (read getattr map open)))
(allow appdomain vendor_ro_audio_prop (file (read getattr map open)))
(allow shell_{{vers}} vendor_misound_ro_prop (file (read getattr map open)))
(allow system_server_{{vers}} vendor_misound_ro_prop (file (read getattr map open)))
(allow audioserver_{{vers}} vendor_misound_ro_prop (file (read getattr map open)))
(allow mediaserver_{{vers}} vendor_misound_ro_prop (file (read getattr map open)))

;; ---- Batch-4 厂商空桩服务注册授权（仅授权 hal_neuralnetworks_default 注册，不对 appdomain 开放 find）----
(allow hal_neuralnetworks_default hal_aidl_dms_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_audio_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_bgs_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_isphal_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_lbs_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_mmagent_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_power_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_applist_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_netdagent_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_nvramagent_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_nwk_opt_service (service_manager (add find)))
(allow hal_neuralnetworks_default mtk_hal_videotelephony_service (service_manager (add find)))
(allow hal_neuralnetworks_default hal_micharge_service (service_manager (add find)))
(allow hal_neuralnetworks_default hal_mikeybag_service (service_manager (add find)))
(allow hal_neuralnetworks_default hal_mrm_service (service_manager (add find)))
