# vendor.awa.reality（MEIZU/awa 触感 HAL，IRealityTap v3）的服务定义。
#
# 来源：原厂 flyme-m22 vendor.img 的 etc/init/vendor.awa.realitytap.service.rc，
# 服务名/二进制/用户组逐字保留；模块内只加了一行 seclabel（原厂靠
# vendor_file_contexts 把 /bin/hw/vendor.awa.realitytap.service 标成
# hal_realitytap_default_exec，本云由 07 步骤 6b 按本行派生同一条）。
#
# 刻意丢弃原厂的两段 trigger：
#   on init  chmod 0666 / chown system system /dev/awa_realitytap_dev
#   on boot  chmod 0666 / chown system system /dev/awa_realitytap_dev
# 该字符设备是本机 awa 触感芯片的节点，云机 virtio 底座没有它；节点不存在时
# chmod/chown 只会刷 denied 噪音（同 meizu_charging 先例）。
#
# 与 realitytap（Flyme framework 服务）的区别：本 rc 只起 vendor HAL；
# "realitytap" 这个名字由 system_server 的 RealityTapManagerService 发布，
# 其标签与 add/find 授权留在机型层 sepolicy。

service vendor.awa.realitytap /vendor/bin/hw/vendor.awa.realitytap.service
    interface aidl vendor.awa.reality.IRealityTap/default
    class hal
    user system
    group system
    seclabel u:r:hal_realitytap_default:s0
