diff --git a/source/kernel/hook/tp_marker.c b/source/kernel/hook/tp_marker.c
index c78bbbdd..556a8396 100644
--- a/source/kernel/hook/tp_marker.c
+++ b/source/kernel/hook/tp_marker.c
@@ -5,8 +5,10 @@
 #include <linux/version.h>
 #include <linux/sched/signal.h>
 #include <linux/sched/task.h>
+#include <linux/workqueue.h>
 
 #include "policy/allowlist.h"
+#include "policy/shell_profile.h"
 #include "klog.h" // IWYU pragma: keep
 #include "selinux/selinux.h"
 
@@ -77,6 +79,62 @@ void ksu_unmark_all_process(void)
     pr_info("tp_marker: unmark all user process done!\n");
 }
 
+static DEFINE_SPINLOCK(shell_mark_lock);
+static bool shell_mark_enabled;
+
+static void shell_mark_work(struct work_struct *work)
+{
+    struct task_struct *p, *t;
+    unsigned long flags;
+    unsigned int marked = 0;
+
+    (void)work;
+    spin_lock_irqsave(&tracepoint_reg_lock, flags);
+    if (tracepoint_reg_count <= 1) {
+        read_lock(&tasklist_lock);
+        for_each_process_thread (p, t) {
+            if (task_uid(t).val != KSU_SHELL_UID)
+                continue;
+            ksu_set_task_tracepoint_flag(t);
+            marked++;
+        }
+        read_unlock(&tasklist_lock);
+    }
+    spin_unlock_irqrestore(&tracepoint_reg_lock, flags);
+    pr_info("tp_marker: marked %u Android shell tasks\n", marked);
+}
+
+static DECLARE_WORK(shell_mark_job, shell_mark_work);
+
+void ksu_mark_start(void)
+{
+    unsigned long flags;
+
+    spin_lock_irqsave(&shell_mark_lock, flags);
+    shell_mark_enabled = true;
+    spin_unlock_irqrestore(&shell_mark_lock, flags);
+}
+
+void ksu_mark_shell(void)
+{
+    unsigned long flags;
+
+    spin_lock_irqsave(&shell_mark_lock, flags);
+    if (shell_mark_enabled)
+        schedule_work(&shell_mark_job);
+    spin_unlock_irqrestore(&shell_mark_lock, flags);
+}
+
+void ksu_mark_stop(void)
+{
+    unsigned long flags;
+
+    spin_lock_irqsave(&shell_mark_lock, flags);
+    shell_mark_enabled = false;
+    spin_unlock_irqrestore(&shell_mark_lock, flags);
+    cancel_work_sync(&shell_mark_job);
+}
+
 void ksu_mark_running_process_locked(void)
 {
     struct task_struct *p, *t;
