diff --git a/source/kernel/policy/shell_profile.c b/source/kernel/policy/shell_profile.c
new file mode 100644
index 00000000..d440f30c
--- /dev/null
+++ b/source/kernel/policy/shell_profile.c
@@ -0,0 +1,38 @@
+#ifdef KSU_HOST_TEST
+#include <string.h>
+#else
+#include <linux/string.h>
+#endif
+
+#include "policy/shell_profile.h"
+
+bool ksu_is_shell_uid(__u32 uid)
+{
+    return uid == KSU_SHELL_UID;
+}
+
+bool ksu_shell_drop(__u32 old_uid, __u32 new_uid)
+{
+    return old_uid != KSU_SHELL_UID && new_uid == KSU_SHELL_UID;
+}
+
+void ksu_shell_prof(struct app_profile *profile, const struct root_profile *root)
+{
+    memset(profile, 0, sizeof(*profile));
+    profile->curr_uid = KSU_SHELL_UID;
+    ksu_guard_shell(profile, root);
+}
+
+void ksu_guard_shell(struct app_profile *profile, const struct root_profile *root)
+{
+    if (!profile || !root || profile->curr_uid != KSU_SHELL_UID)
+        return;
+
+    profile->version = KSU_APP_PROFILE_VER;
+    memset(profile->key, 0, sizeof(profile->key));
+    memcpy(profile->key, KSU_SHELL_KEY, sizeof(KSU_SHELL_KEY));
+    memset(&profile->rp_config, 0, sizeof(profile->rp_config));
+    profile->allow_su = true;
+    profile->rp_config.use_default = true;
+    memcpy(&profile->rp_config.profile, root, sizeof(*root));
+}
