<?xml version="1.0" encoding="utf-8"?>
<!--
  vibrator 能力清单（设备独有，随机型 vendor 镜像下发）。

  改值不需要重编 HAL：vibrator 服务启动时读本文件；缺文件/缺属性一律回退
  编码内默认（见 vibrator_service.cpp 的 VibratorConfig）。

  取值来源：m22 实测能力（vibratorIds=[1]、iVibratorCapability=0、
  iVibratorManagerCapabilities=0、supportedEffects 5 条、compositionDelayMax=1000、
  compositionSizeMax=256）。
    register-manager        = 是否注册 IVibratorManager（false 时只注册 IVibrator）
    capabilities            = IVibrator.getCapabilities() 位集（0 = 仅 on/off）
    manager-capabilities    = IVibratorManager.getCapabilities() 位集
    composition-delay-max   = 组合振动最大延迟 ms
    composition-size-max    = 组合振动最大步数
    <vibrator id>           = getVibratorIds() 暴露的 vibrator 编号
    <effect name>           = getSupportedEffects() 支持的原语
-->
<vibrator-config register-manager="true"
                 capabilities="0"
                 manager-capabilities="0"
                 composition-delay-max="1000"
                 composition-size-max="256">
    <vibrator id="1"/>
    <effect name="CLICK"/>
    <effect name="DOUBLE_CLICK"/>
    <effect name="TICK"/>
    <effect name="HEAVY_CLICK"/>
    <effect name="TEXTURE_TICK"/>
</vibrator-config>
