# vendor.meizu.hardware.aw_light（MEIZU 灯效 HAL）的服务定义。
#
# 来源：原厂 flyme-m22 vendor.img 的 etc/init/vendor.meizu.hardware.aw_light-service.rc，
# 收进模块后加了两行（原厂这两件事都靠 vendor_file_contexts / 独立文件完成）：
#   interface aidl …  让 servicemanager 按 AIDL 实例名登记，并支持 lazy 查询；
#   seclabel …        显式换域；可执行标签由 07 步骤 6b 按本行派生
#                     /(vendor|system/vendor)/bin/hw/vendor.meizu.hardware.aw_light-service
#                     → u:object_r:hal_aw_light_default_exec:s0（与原厂一致）。
#
# 分层：域与授权见模块根目录的 sepolicy/；本文件不写任何设备路径，换机型不用改。
# 原厂 rc 只有 service 段（灯效节点由 HAL 自己 open，不靠 init chmod），故无非 service 段要搬。

service vendor.default.aw_light /vendor/bin/hw/vendor.meizu.hardware.aw_light-service
    class late_start
    user system
    group system
    interface aidl vendor.meizu.hardware.aw_light.IAwLight/default
    seclabel u:r:hal_aw_light_default:s0
