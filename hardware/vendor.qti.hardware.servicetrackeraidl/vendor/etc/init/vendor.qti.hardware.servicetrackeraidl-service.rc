# vendor.qti.hardware.servicetrackeraidl（高通服务跟踪 HAL）的服务定义。
#
# 来源：原厂 flyme-m22 vendor.img 的 etc/init/ 同名文件，收进模块后只加了一行
# seclabel（原厂靠 vendor_file_contexts 的 vendor_hal_srvctracker_default_exec
# 做域转换），其余与厂商原版一致。
#
# 分层：域与授权见模块根目录的 sepolicy/（07 步骤 6 注入）；本文件不写任何设备
# 路径，换机型不用改。可执行标签由 07 步骤 6b 按下一行的 seclabel 派生。

service vendor.servicetrackeraidl /vendor/bin/hw/vendor.qti.hardware.servicetrackeraidl-service
    class hal
    user system
    group system
    interface aidl vendor.qti.hardware.servicetrackeraidl.IServicetracker/default
    seclabel u:r:vendor_hal_srvctracker_default:s0
