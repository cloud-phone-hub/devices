;; vendor.meizu.hardware.aw_light（MEIZU 灯效 HAL，自研实现）的 SELinux 片段，
;; 由 07_build_vendor 步骤 6 以 marker
;;（;; cdh-patch-begin: vendor_sepolicy.cil@vendor.meizu.hardware.aw_light）
;; 整块并入装配树 /vendor/etc/selinux/vendor_sepolicy.cil；同一 marker 重复执行幂等。
;;
;; 为什么在模块层：域、可执行标签、服务名标签都是这个 HAL 自身的契约，换机型不重写。
;; 机型层原本只有 hal_aw_light_service 的类型与 system_server 的 find 授权（"无实体的
;; 占位标签"），自研实体接入后整段搬到这里，机型层同批删除（重复 (type …) 会让 secilc
;; Failed to resolve → init InitFatalReboot）。
;;
;; 与原厂的差异：原厂 vendor_sepolicy.cil（202404 基线）把域挂进 protected_service /
;; halserverdomain 等大 attribute，并有 hal_aw_light_client / aw_light_sysfs /
;; aw_light_device（/dev/rgb_led、rgb_led sysfs）一整套授权——那是驱动真实 led 控制器
;; 才需要的。本云实现不 open 任何设备节点、不写 sysfs，故一条都不搬；将来真接硬件
;; 再从原厂策略里取回，并按下放判据留在机型层（路径绑本机 i2c 控制器）。
;; 平台域一律用 {{vers}} 占位，由构建阶段按 plat_sepolicy_vers.txt 替换。

;; ---- 1) 域与可执行标签 ----
;; 进程域必须归入 domain 属性：缺它 init 的 setexeccon 报 EINVAL，服务 fork 后 ab
;;（logcat：`cannot setexeccon('u:r:hal_aw_light_default:s0') for vendor.default.aw_light:
;; Invalid argument` + `Service 'vendor.default.aw_light' received signal 6`），
;; SystemServer 在 LightsService.connectToHal 等 IAwLight 到 66s 被 Watchdog 杀掉、整机重启循环。
;; 写法同 android.service.daemon 的 pioneer；gold 成品靠这份属性，本基底现场合并得自己补。
(type hal_aw_light_default)
(typeattributeset domain (hal_aw_light_default))
(roletype object_r hal_aw_light_default)
(type hal_aw_light_default_exec)
(roletype object_r hal_aw_light_default_exec)

;; ---- 2) init 启动链 ----
;; rc 的 seclabel 让 init 显式换域；exec 标签由 07 步骤 6b 按同一行派生
;;（/(vendor|system/vendor)/bin/hw/vendor.meizu.hardware.aw_light-service）。
(allow init_{{vers}} hal_aw_light_default_exec (file (read getattr map execute open entrypoint)))
(allow init_{{vers}} hal_aw_light_default (process (transition noatsecure siginh rlimitinh)))
(allow hal_aw_light_default hal_aw_light_default_exec (file (read getattr map execute open entrypoint)))
(dontaudit init_{{vers}} hal_aw_light_default (process (noatsecure)))

;; ---- 3) AIDL 服务注册与查询 ----
;; 服务名标签走同目录 vendor_service_contexts。
(type hal_aw_light_service)
(roletype object_r hal_aw_light_service)
(typeattributeset service_manager_type (hal_aw_light_service))
(allow hal_aw_light_default servicemanager_{{vers}} (binder (call transfer)))
(allow hal_aw_light_default hal_aw_light_service (service_manager (add find)))
(allow system_server_{{vers}} hal_aw_light_service (service_manager (find)))

;; ---- 4) Binder 域间调用 ----
;; 调用方是 Flyme framework（system_server）；code 10 会把客户端的 IAwLightCallback
;; 以 binder 进来，故按双向授权（与基座 binder_call 宏的产出同款）。
(allow system_server_{{vers}} hal_aw_light_default (binder (call)))
(allow hal_aw_light_default system_server_{{vers}} (binder (call)))
