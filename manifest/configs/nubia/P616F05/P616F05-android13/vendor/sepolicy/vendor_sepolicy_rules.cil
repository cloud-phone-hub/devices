;; Unisoc 展锐 miscdata HAL 条件 SELinux 绑定
;; @when-file bin/hw/vendor.sprd.hardware.miscdata@1.0-service
;; @ensure-type hal_miscdata_default hal_miscdata_default_exec hal_miscdata_hwservice
(typeattributeset domain (hal_miscdata_default))
(typeattributeset halserverdomain (hal_miscdata_default))
(typeattributeset file_type (hal_miscdata_default_exec))
(typeattributeset exec_type (hal_miscdata_default_exec))
(typeattributeset vendor_file_type (hal_miscdata_default_exec))
(typeattributeset hwservice_manager_type (hal_miscdata_hwservice))
(allow init_{{vers}} hal_miscdata_default_exec (file (read getattr map execute open)))
(allow init_{{vers}} hal_miscdata_default (process (transition siginh rlimitinh)))
(dontaudit init_{{vers}} hal_miscdata_default (process (noatsecure)))
(typetransition init_{{vers}} hal_miscdata_default_exec process hal_miscdata_default)
(allow hal_miscdata_default hal_miscdata_default_exec (file (read getattr map execute open entrypoint)))
(allow hal_miscdata_default hwservicemanager_{{vers}} (binder (call transfer)))
(allow hwservicemanager_{{vers}} hal_miscdata_default (binder (call transfer)))
(allow hwservicemanager_{{vers}} hal_miscdata_default (dir (search)))
(allow hwservicemanager_{{vers}} hal_miscdata_default (file (read map open)))
(allow hwservicemanager_{{vers}} hal_miscdata_default (process (getattr)))
(allow hal_miscdata_default hwservicemanager_prop_{{vers}} (file (read getattr map open)))
(allow hal_miscdata_default hwbinder_device_{{vers}} (chr_file (ioctl read write getattr lock append map open)))
(allow hal_miscdata_default hal_miscdata_hwservice (hwservice_manager (add find)))
(allow hal_miscdata_default hidl_base_hwservice_{{vers}} (hwservice_manager (add)))
(allow hal_miscdata_default block_device_{{vers}} (dir (search)))
(allow hal_miscdata_default ufs_device (blk_file (read write open getattr)))
(allow hal_miscdata_default factory_block_device (blk_file (read write open getattr)))
(allow hal_miscdata_default mmcblk_device (blk_file (read write open getattr)))
(allow hal_miscdata_default userdata_block_device_{{vers}} (blk_file (read write open getattr)))
(allow system_server_{{vers}} hal_miscdata_hwservice (hwservice_manager (find)))
(allow system_server_{{vers}} hal_miscdata_default (binder (call transfer)))
(allow hal_miscdata_default system_server_{{vers}} (binder (transfer)))
(allow system_app_{{vers}} hal_miscdata_hwservice (hwservice_manager (find)))
(allow system_app_{{vers}} hal_miscdata_default (binder (call transfer)))
(allow hal_miscdata_default system_app_{{vers}} (binder (transfer)))
(allow platform_app_{{vers}} hal_miscdata_hwservice (hwservice_manager (find)))
(allow platform_app_{{vers}} hal_miscdata_default (binder (call transfer)))
(allow hal_miscdata_default platform_app_{{vers}} (binder (transfer)))
;; @end
