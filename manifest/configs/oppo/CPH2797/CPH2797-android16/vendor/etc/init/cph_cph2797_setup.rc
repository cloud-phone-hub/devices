# CDH:
# 1. 创建 /data/vendor/nfc 与 /data/nfc 目录，避免 com.android.nfc 首次写入时触发 vendor_data_file AVC；
# 2. 解锁/开机后执行 /vendor/bin/cph_cph2797_setup.sh 将解密后的 OplusCamera 配置写入应用沙箱。
on post-fs-data
    mkdir /data/vendor/nfc 0770 nfc nfc
    mkdir /data/nfc 0770 nfc nfc

service cph_cph2797_setup /system/bin/sh /vendor/bin/cph_cph2797_setup.sh
    class late_start
    user root
    group root system
    seclabel u:r:pioneer:s0
    oneshot
    disabled

on property:sys.user.0.ce_available=true
    start cph_cph2797_setup

on property:sys.boot_completed=1
    start cph_cph2797_setup
