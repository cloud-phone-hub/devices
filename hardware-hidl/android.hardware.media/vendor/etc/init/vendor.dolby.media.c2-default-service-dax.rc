service vendor-dolby-media-c2-hal /vendor/bin/hw/vendor.dolby.media.c2-default-service-dax
    class hal
    user mediacodec
    group camera mediadrm drmrpc
    ioprio rt 4
    task_profiles ProcessCapacityHigh
    seclabel u:r:mediacodec:s0
    interface android.hardware.media.c2@1.0::IComponentStore default9
    interface android.hardware.media.c2@1.1::IComponentStore default9
    interface android.hardware.media.c2@1.2::IComponentStore default9
