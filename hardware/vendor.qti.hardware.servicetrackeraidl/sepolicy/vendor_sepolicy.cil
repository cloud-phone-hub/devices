;; vendor.qti.hardware.servicetrackeraidl（高通服务跟踪 HAL，厂商预编译）的
;; SELinux 片段，由 07_build_vendor 步骤 6 以 marker
;;（;; cdh-patch-begin: vendor_sepolicy.cil@vendor.qti.hardware.servicetrackeraidl）
;; 整块并入装配树 /vendor/etc/selinux/vendor_sepolicy.cil；同一 marker 重复执行幂等。
;;
;; 为什么在模块层：本模块以 kind=prebuilt 收进原厂二进制、rc 与 VINTF（vendor/
;; 静态树），域、可执行标签、服务名标签都是这个 HAL 自身的契约——换机型不重写。
;;
;; 与原厂的差异：原厂 vendor_sepolicy.cil（202404 基线）把域挂进 protected_service
;; / protected_hwservice / halserverdomain 等大 attribute 行，那是 Flyme 全量策略的
;; 编排；本云只需要类型声明与启动/注册/调用所需的最小授权，故不搬那些 attribute。
;; 平台域一律用 {{vers}} 占位，由构建阶段按 plat_sepolicy_vers.txt 替换。

;; ---- 1) 域与可执行标签 ----
;; 进程域必须归入 domain 属性，否则 init 的 setexeccon 报 EINVAL、服务 fork 后 signal 6
;;（同 vendor.meizu.hardware.aw_light 的说明）。
(type vendor_hal_srvctracker_default)
(typeattributeset domain (vendor_hal_srvctracker_default))
(roletype object_r vendor_hal_srvctracker_default)
(type vendor_hal_srvctracker_default_exec)
(roletype object_r vendor_hal_srvctracker_default_exec)

;; ---- 2) init 启动链 ----
;; rc 的 seclabel 让 init 显式换域；exec 标签由 07 步骤 6b 按同一行派生
;;（/(vendor|system/vendor)/bin/hw/vendor.qti.hardware.servicetrackeraidl-service）。
(allow init_{{vers}} vendor_hal_srvctracker_default_exec (file (read getattr map execute open entrypoint)))
(allow init_{{vers}} vendor_hal_srvctracker_default (process (transition noatsecure siginh rlimitinh)))
(allow vendor_hal_srvctracker_default vendor_hal_srvctracker_default_exec (file (read getattr map execute open entrypoint)))
(dontaudit init_{{vers}} vendor_hal_srvctracker_default (process (noatsecure)))

;; ---- 3) AIDL 服务注册与查询 ----
;; 服务名标签走同目录 vendor_service_contexts；system_server 是唯一客户端
;;（原厂 vendor_hal_srvctracker_client 的成员之一，另一个是 perf HAL）。
(type vendor_hal_srvctracker_service)
(roletype object_r vendor_hal_srvctracker_service)
(typeattributeset service_manager_type (vendor_hal_srvctracker_service))
(allow vendor_hal_srvctracker_default servicemanager_{{vers}} (binder (call transfer)))
(allow vendor_hal_srvctracker_default vendor_hal_srvctracker_service (service_manager (add find)))
(allow system_server_{{vers}} vendor_hal_srvctracker_service (service_manager (find)))

;; ---- 4) Binder 域间调用 ----
;; IServicetracker 的接口由 system_server 调用；AIDL 客户端可能拿到回调 binder，
;; 故按双向授权（与基座 binder_call 宏的产出同款）。
(allow system_server_{{vers}} vendor_hal_srvctracker_default (binder (call)))
(allow vendor_hal_srvctracker_default system_server_{{vers}} (binder (call)))
