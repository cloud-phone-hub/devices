<?xml version="1.0" encoding="utf-8"?>
<!--
  thermal 温度模型与传感器清单（设备独有，随机型 vendor 镜像下发）。

  本 HAL 是虚拟 thermal HAL：温度由「基线 + 加热/冷却模型」合成，不发真实热量。
  改值不需要重编 HAL，缺文件则回退编码内默认模型（见 thermal_service.cpp）。

  取值来源：gold（Redmi Note 13 5G, android15）真机 dumpsys thermalservice 的
  Temperature 列表与多级阈值（thresholds 用分号分隔，nan 表示无该级）。
    skin-name/skin-celsius  = 皮肤温度传感器名与基线
    model-*                 = 加热/冷却速率模型参数
    <sensor id name value thresholds shutdown>  = CPU/GPU/... 各温区
    <cooling id name value>                     = 冷却设备（风扇/充电限流）
-->
<thermal-config skin-name="SKIN" skin-celsius="27.843" model-maximum-celsius="50"
                model-heating-seconds="20" model-cooling-seconds="45" model-sample-interval-ms="1000">
    <sensor id="0" name="CPU" value="29.174"
            thresholds="nan;nan;nan;85;90;100;117"
            shutdown="nan;nan;nan;nan;nan;nan;nan"/>
    <sensor id="1" name="GPU" value="29.174"
            thresholds="nan;nan;nan;85;90;100;117"
            shutdown="nan;nan;nan;nan;nan;nan;nan"/>
    <sensor id="2" name="BATTERY" value="26.0"
            thresholds="nan;nan;nan;50;55;59;60"
            shutdown="nan;nan;nan;nan;nan;nan;nan"/>
    <sensor id="3" name="SKIN" value="27.843"
            thresholds="nan;43;45;50;70;80;90"
            shutdown="nan;nan;nan;nan;nan;nan;nan"/>
    <sensor id="5" name="POWER_AMPLIFIER" value="28.128"
            thresholds="nan;nan;nan;68;90;100;110"
            shutdown="nan;nan;nan;nan;nan;nan;nan"/>
    <sensor id="9" name="NPU" value="29.174"
            thresholds="nan;nan;nan;85;90;100;117"
            shutdown="nan;nan;nan;nan;nan;nan;nan"/>
    <sensor id="10" name="TPU" value="29.174"
            thresholds="nan;nan;nan;85;90;100;117"
            shutdown="nan;nan;nan;nan;nan;nan;nan"/>
    <sensor id="13" name="SOC" value="29.174"
            thresholds="nan;nan;nan;85;90;100;117"
            shutdown="nan;nan;nan;nan;nan;nan;nan"/>
    <cooling id="3" name="devfreq-13000000.mali" value="0"/>
</thermal-config>
