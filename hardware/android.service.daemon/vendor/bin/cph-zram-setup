#!/system/bin/sh
# 云机 ZRAM 交换分区幂等初始化（对齐 6291452 kB = 6 GiB Swap 口径）。
#
# 当 Lineage virtio 基底 init.<board>.rc 未执行 swapon_all /vendor/etc/fstab.enableswap
# 导致 /sys/block/zram0/disksize 为 0 时，启用 lz4 压缩并挂载 6 GiB zram0（6442450944 B =
# 6291456 KiB，扣 4 KiB swap header 后可用 SwapTotal 精确等于 6291452 kB）。
# 若厂商 rc 已挂载 zram0 则幂等跳过。
set -u

log() { /system/bin/log -t cph-zram-setup "$@"; }

if /system/bin/grep -q '/zram0' /proc/swaps 2>/dev/null; then
    log "zram0 已激活，跳过"
    exit 0
fi

if [ ! -e /sys/block/zram0/disksize ] || [ ! -b /dev/block/zram0 ]; then
    log "未检测到 /dev/block/zram0，跳过"
    exit 0
fi

cur_size="$(/system/bin/cat /sys/block/zram0/disksize 2>/dev/null || echo 0)"
if [ "${cur_size}" = "0" ] || [ -z "${cur_size}" ]; then
    if /system/bin/grep -qw lz4 /sys/block/zram0/comp_algorithm 2>/dev/null; then
        echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || true
    fi
    # 6291456 * 1024 = 6442450944（mkswap 扣 4KB 页头后可用容量正好 6291452 kB）
    echo 6442450944 > /sys/block/zram0/disksize 2>/dev/null || {
        log "写入 /sys/block/zram0/disksize 失败"
        exit 0
    }
fi

/system/bin/mkswap /dev/block/zram0 >/dev/null 2>&1 || {
    log "mkswap /dev/block/zram0 失败"
    exit 0
}
/system/bin/swapon /dev/block/zram0 >/dev/null 2>&1 || {
    log "swapon /dev/block/zram0 失败"
    exit 0
}

log "已启用 /dev/block/zram0（6291452 kB）"
