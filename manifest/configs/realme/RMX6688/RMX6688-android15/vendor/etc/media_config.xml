<?xml version="1.0" encoding="utf-8"?>
<!-- RMX6688 media codec2 store 最小登记（rank=1 保证软解与 v4l2 优先，防止 c2 store 缺配置退出触发 updatable_crashing）。 -->
<media-c2-config>
    <instance binary="android.hardware.media.c2-mediatek" store="default1"/>
    <instance binary="vendor.dolby.media.c2-default-service-dax" store="default9"/>
    <component
        store="default1"
        name="c2.mtk.avc.decoder"
        kind="decoder"
        domain="video"
        media-type="video/avc"
        rank="1"
        aliases="OMX.MTK.VIDEO.DECODER.AVC"
        profiles="1,2,8"
        levels="4096"/>
    <component
        store="default9"
        name="c2.dolby.eac3.decoder"
        kind="decoder"
        domain="audio"
        media-type="audio/eac3"
        rank="1"
        aliases=""
        profiles=""
        levels=""/>
    <component
        store="default9"
        name="c2.dolby.ac4.decoder"
        kind="decoder"
        domain="audio"
        media-type="audio/ac4"
        rank="1"
        aliases="OMX.dolby.ac4.decoder"
        profiles=""
        levels=""/>
</media-c2-config>
