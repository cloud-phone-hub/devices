<!--
    vendor.meizu.hardware.aw_light 的 VINTF 片段。

    来源：原厂 flyme-m22 vendor.img 的 etc/vintf/manifest/ 同名文件，逐字保留
    （版本号 1.0、<version>1</version> 都是原厂写法；本云只把实现换成了自研，
    对外声明不变，06/07 原样并入装配树的 etc/vintf/manifest/）。
-->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>vendor.meizu.hardware.aw_light</name>
        <version>1</version>
        <interface>
            <name>IAwLight</name>
            <instance>default</instance>
        </interface>
        <fqname>IAwLight/default</fqname>
    </hal>
</manifest>
