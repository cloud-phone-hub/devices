# engine/vendor 自研 vendor.meizu.sensor_aux.ISensorAux **桩**服务。
#
# 为什么必须有它：system_server 的 libsensorservice 在 onSampleResult 回调里**同步**
# getService("vendor.meizu.sensor_aux.ISensorAux/default")，实体缺失时每轮睡满 5 s；
# 该回调正是它所在 binder 节点的 oneway 闸门持有者，5 s 的持闸时长会把 system_server
# 的粘性异步预算顶到天花板（详见模块头注释与证据目录
# devices/flyme/m22/build/doc/evidence/issue-m22-sf-oneway-async-saturation）。
#
# disabled + on post-fs-data 显式 start：客户端是 system_server 内的 native getService，
# 首次调用发生在 sensorservice 起来之后，post-fs-data 启动足够早；显式 start 又避开
# class 批量启动窗口的失败重试。
# SELinux：复用底座标准域 hal_sensors_default（本仓自研 HAL 一律复用基座标准域）；
#   本名标签与 hal_sensors_default 的 service_manager(add find) 由模块根目录的
#   sepolicy/ 片段给出，机型层不再声明。
#   可执行标签由 07_build_vendor 步骤 6b 按本文件的 seclabel 自动补 _exec 规则。
service vendor.sensor_aux-default /vendor/bin/hw/vendor.meizu.sensor_aux-service
    class hal
    user system
    group system
    seclabel u:r:hal_sensors_default:s0
    interface aidl vendor.meizu.sensor_aux.ISensorAux/default
    disabled

on post-fs-data
    start vendor.sensor_aux-default
