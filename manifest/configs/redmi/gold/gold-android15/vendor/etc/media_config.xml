<?xml version="1.0" encoding="utf-8"?>
<!--
  media codec2 store 实例与组件表（设备独有，随机型 vendor 镜像下发）。

  真机每个 vendor 二进制只注册一个 C2 store 实例（rc 不传参，由二进制名选实例）；
  本文件声明「二进制 basename → 实例名」与「实例 → 组件表」。改表不需要重编 HAL，
  缺文件则实例/组件均为空（服务照起，framework 看不到任何 vendor 编解码器）。

  取值来源：gold（Redmi Note 13 5G, android15）真机 /vendor/bin/hw/*c2* 注册结果 +
  dumpsys media.codec 的 C2Component 列表（aliases 来自同名 OMX 组件）。
    instance.binary   = /vendor/bin/hw/ 下的 C2 store 二进制名
    instance.store    = 该二进制注册的 store 实例名（等于 rc 里的 interface suffix）
    component.store   = 归属实例；name/kind/domain/media-type/rank 与 C2 登记一致
    component.aliases = 逗号分隔的旧 OMX 名（framework 需要别名转接）
    component.profiles/levels = 逗号分隔的 C2 profile/level 整数（取真机 dumpsys）
-->
<media-c2-config>
    <instance binary="android.hardware.media.c2-mediatek" store="default1"/>
    <instance binary="vendor.dolby.media.c2-default-service-dax" store="default9"/>
    <component
        store="default1"
        name="c2.mtk.hevc.decoder"
        kind="decoder"
        domain="video"
        media-type="video/hevc"
        rank="512"
        aliases="OMX.MTK.VIDEO.DECODER.HEVC"
        profiles="24576,24578,24577"
        levels="24835"/>
