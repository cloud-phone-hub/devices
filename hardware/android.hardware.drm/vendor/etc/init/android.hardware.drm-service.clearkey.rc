# engine/vendor 自研 DRM HAL（clearkey）：底座没有 DRM HAL，由本服务注册
# android.hardware.drm.IDrmFactory/clearkey，MediaDrm 据此提供 ClearKey 方案
# （不含 Widevine）。
service vendor.drm-clearkey /vendor/bin/hw/android.hardware.drm-service.clearkey
    class hal
    user mediadrm
    group mediadrm drmrpc
    seclabel u:r:hal_drm_clearkey_aidl:s0
    interface aidl android.hardware.drm.IDrmFactory/clearkey
