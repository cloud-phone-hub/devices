;; OPlus displaycolorfeature 条件绑定（对应 hal_graphics_composer_default）
;; @when-declared hal_displaycolorfeature hal_displaycolorfeature_client hal_displaycolorfeature_server hal_graphics_composer_default surfaceflinger_{{vers}}
;; @when-not-contains (typeattributeset hal_displaycolorfeature_server (hal_graphics_composer_default))
(typeattributeset hal_displaycolorfeature (hal_graphics_composer_default))
(typeattributeset hal_displaycolorfeature_client (surfaceflinger_{{vers}}))
(typeattributeset hal_displaycolorfeature_server (hal_graphics_composer_default))
(allow hal_displaycolorfeature_client hal_displaycolorfeature_server (binder (call transfer)))
(allow hal_displaycolorfeature_server hal_displaycolorfeature_client (binder (transfer)))
(allow hal_displaycolorfeature_client hal_displaycolorfeature_server (fd (use)))
;; @end
;; @end
;; MTK 开机动画域跨分区授权（严禁授权 vendor_file 普通文件以避开 coredomain neverallow）
;; @when-declared mtkbootanimation_{{vers}}
(allow mtkbootanimation_{{vers}} bootanim_system_prop_{{vers}} (file (read getattr map open)))
(allow mtkbootanimation_{{vers}} bootanim_config_prop_{{vers}} (file (read getattr map open)))
(allow mtkbootanimation_{{vers}} dri_device (chr_file (ioctl read write getattr lock append map open)))
(allow surfaceflinger_{{vers}} mtkbootanimation_{{vers}} (binder (call transfer)))
(allow mtkbootanimation_{{vers}} surfaceflinger_{{vers}} (binder (transfer)))
(allow surfaceflinger_{{vers}} mtkbootanimation_{{vers}} (fd (use)))
(allow surfaceflinger_{{vers}} mtkbootanimation_{{vers}} (dir (search)))
(allow surfaceflinger_{{vers}} mtkbootanimation_{{vers}} (file (read getattr map open)))
(allow mtkbootanimation_{{vers}} surfaceflinger_{{vers}} (unix_stream_socket (read write)))
(allow mediaserver_{{vers}} mtkbootanimation_{{vers}} (binder (call transfer)))
(allow mtkbootanimation_{{vers}} mediaserver_{{vers}} (binder (transfer)))
(allow mediaserver_{{vers}} mtkbootanimation_{{vers}} (fd (use)))
(allow mtkbootanimation_{{vers}} statsdw_socket_{{vers}} (sock_file (write)))
(allow mtkbootanimation_{{vers}} statsd_{{vers}} (unix_dgram_socket (sendto)))
;; @end

;; MTK audio_vendor_parameter_parser 跨命名空间访问最小授权
;; @when-any-declared audio_vendor_parameter_parser_{{vers}} audio_vendor_parameter_parser
(allow {{pick:audio_vendor_parameter_parser}} {{pick:vendor_file}} (dir (ioctl read getattr lock open search)))
(allow {{pick:audio_vendor_parameter_parser}} {{pick:vendor_file}} (lnk_file (read getattr open)))
(allow {{pick:audio_vendor_parameter_parser}} {{pick:same_process_hal_file}} (dir (ioctl read getattr lock open search)))
(allow {{pick:audio_vendor_parameter_parser}} {{pick:same_process_hal_file}} (file (read getattr map execute open)))
(allow {{pick:audio_vendor_parameter_parser}} {{pick:same_process_hal_file}} (lnk_file (read getattr open)))
(allow {{pick:audio_vendor_parameter_parser}} {{pick:vndk_sp_file}} (dir (ioctl read getattr lock open search)))
(allow {{pick:audio_vendor_parameter_parser}} {{pick:vndk_sp_file}} (file (read getattr map execute open)))
(allow {{pick:audio_vendor_parameter_parser}} {{pick:vndk_sp_file}} (lnk_file (read getattr open)))
(allow {{pick:audio_vendor_parameter_parser}} {{pick:vendor_configs_file}} (dir (ioctl read getattr lock open search)))
(allow {{pick:audio_vendor_parameter_parser}} {{pick:vendor_configs_file}} (file (read getattr map open)))
(allow {{pick:audio_vendor_parameter_parser}} {{pick:vendor_configs_file}} (lnk_file (read getattr open)))
;; @end

;; CPH2797 NFC 域查找与调用 neuralnetworks 托管的 NXP/Oplus NFC AIDL 占位服务
;; @when-declared hal_oplus_nfc_service hal_neuralnetworks_default nfc_{{vers}}
(allow hal_neuralnetworks_default hal_oplus_nfc_service (service_manager (add find)))
(allow nfc_{{vers}} hal_oplus_nfc_service (service_manager (find)))
(allow nfc_{{vers}} hal_neuralnetworks_default (binder (call transfer)))
(allow hal_neuralnetworks_default nfc_{{vers}} (binder (transfer)))
;; @end

;; CPH2797 放行 opluscamera_app 读写自身沙箱目录 opluscamera_app_data_file
;; @when-declared opluscamera_app_{{vers}} opluscamera_app_data_file_{{vers}}
(allow opluscamera_app_{{vers}} opluscamera_app_data_file_{{vers}} (dir (ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow opluscamera_app_{{vers}} opluscamera_app_data_file_{{vers}} (file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
(allow opluscamera_app_{{vers}} opluscamera_app_data_file_{{vers}} (lnk_file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
;; @end

;; CPH2797 放行 cameraserver 设置 opluscamera_app 调度优先级
;; @when-declared cameraserver_{{vers}} opluscamera_app_{{vers}}
(allow cameraserver_{{vers}} opluscamera_app_{{vers}} (process (setsched)))
;; @end

;; CPH2797 放行 mediaserver/mediaextractor/mediaswcodec 使用 opluscamera_app 传入的录像输出文件 fd
;; @when-declared mediaserver_{{vers}} opluscamera_app_{{vers}} opluscamera_app_data_file_{{vers}}
(allow mediaserver_{{vers}} opluscamera_app_{{vers}} (fd (use)))
(allow mediaserver_{{vers}} opluscamera_app_{{vers}} (binder (call transfer)))
(allow opluscamera_app_{{vers}} mediaserver_{{vers}} (binder (call transfer)))
(allow mediaserver_{{vers}} opluscamera_app_data_file_{{vers}} (dir (search)))
(allow mediaserver_{{vers}} opluscamera_app_data_file_{{vers}} (file (ioctl read write getattr lock append map)))
;; @end
;; @when-declared mediaextractor_{{vers}} opluscamera_app_{{vers}} opluscamera_app_data_file_{{vers}}
(allow mediaextractor_{{vers}} opluscamera_app_{{vers}} (fd (use)))
(allow mediaextractor_{{vers}} opluscamera_app_data_file_{{vers}} (file (ioctl read getattr lock map)))
;; @end
;; @when-declared mediaswcodec_{{vers}} opluscamera_app_{{vers}} opluscamera_app_data_file_{{vers}}
(allow mediaswcodec_{{vers}} opluscamera_app_{{vers}} (fd (use)))
(allow mediaswcodec_{{vers}} opluscamera_app_data_file_{{vers}} (file (ioctl read write getattr lock append map)))
;; @end
