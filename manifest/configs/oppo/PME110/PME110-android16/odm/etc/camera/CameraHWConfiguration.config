    scene[13] = 6;       0x8001;  84;           28;           -2;                2;                   0;      2;                32;             32;

[FeatureDownFPSOisReturn]
         # cameraId; multiExpTime(unit ms); multiExpFactor; mutilExpOffset; oneExpTime(unit ms); oneExpFactor; oneExpOffset;
    Mode[0] = 2;                12;                 -5;           340;                15;             -10;           440;
    Mode[1] = 4;                 0;                  0;             0;                20;               0;             0;

[FeatureCameraMonitor]
    MonitorItem = 7;
    AbortWhenDetectFail = true;

[LimitFPSRange]
    #Item            captureMode  cameraId  minFPS
    Item[0]     =      0x8021;        1;      24   #Front 60fps video

[FeatureProVideo]
    isSupportMasterTone = true;
    isSupportLogMonit = true;

[LUTConfiguration]
