<?xml version="1.0" encoding="utf-8"?>
<!-- itel A6612L (itel/itel-A6612L) Codec2 Store 实例与组件登记（rank=512/1024 确保 v4l2 硬解硬编与 AOSP 软解优先，且保证每个 store 非空） -->
<media-c2-config>
    <instance binary="android.hardware.media.c2-mediatek" store="default1"/>
    <instance binary="vendor.dolby.media.c2-default-service-dax" store="default9"/>
    <instance binary="android.hardware.media.c2@1.1-unisoc-service" store="cdh"/>
    <component store="default1" name="c2.mtk.avc.decoder" kind="decoder" domain="video" media-type="video/avc" rank="512" aliases="OMX.MTK.VIDEO.DECODER.AVC" profiles="20480,20481,20482,20484,20487" levels="20495"/>
    <component store="default9" name="c2.dolby.eac3.decoder" kind="decoder" domain="audio" media-type="audio/eac3" rank="1024" aliases="" profiles="" levels=""/>
    <component store="cdh" name="c2.qti.avc.decoder" kind="decoder" domain="video" media-type="video/avc" rank="512" aliases="OMX.qcom.VIDEO.DECODER.AVC" profiles="20480,20481,20482,20484,20487" levels="20495"/>
</media-c2-config>
