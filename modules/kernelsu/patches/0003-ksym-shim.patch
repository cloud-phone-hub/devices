+};
+
+/* 先试直接查；kprobe 只用来拿 kallsyms_lookup_name 的地址。 */
+static int ksu_ksym_bootstrap(void)
+{
+    struct kprobe kp = { .symbol_name = "kallsyms_lookup_name" };
+    unsigned long addr;
+    int rc;
+
+    rc = register_kprobe(&kp);
+    if (rc) {
+        pr_err("ksym: register kprobe on kallsyms_lookup_name failed: %d\n", rc);
+        return rc;
+    }
+    addr = (unsigned long)kp.addr;
+    unregister_kprobe(&kp);
+
+    if (!addr) {
+        pr_err("ksym: kprobe got null addr for kallsyms_lookup_name\n");
+        return -ENOENT;
+    }
+    ksu_ksym_lookup = (typeof(kallsyms_lookup_name) *)addr;
+    return 0;
+}
+
+int __init ksu_ksym_init(void)
+{
+    size_t i, missing = 0;
+    int rc;
+
+    rc = ksu_ksym_bootstrap();
+    if (rc)
+        return rc;
+
+    for (i = 0; i < ARRAY_SIZE(ksu_ksym_table); i++) {
+        const struct ksu_ksym_desc *d = &ksu_ksym_table[i];
+
+        *d->slot = (void *)ksu_ksym_lookup(d->name);
+        if (!*d->slot) {
+            pr_err("ksym: unresolved: %s\n", d->name);
+            missing++;
+        }
+    }
+
+    if (missing) {
+        pr_err("ksym: %zu/%zu symbols unresolved\n", missing, ARRAY_SIZE(ksu_ksym_table));
+        return -ENOENT;
+    }
+
+    /* 本地快照：让 security/selinux 的 inline 拿到真实的 blob 大小。 */
+    memcpy(&selinux_blob_sizes, ksu_sym_selinux_blob_sizes, sizeof(selinux_blob_sizes));
+    pr_info("ksym: %zu symbols resolved (%zu funcs via trampoline, %zu data)\n",
+            ARRAY_SIZE(ksu_ksym_table), ARRAY_SIZE(ksu_ksym_table) - 5, (size_t)5);
+    return 0;
+}
diff --git a/source/kernel/infra/ksym_tramp.S b/source/kernel/infra/ksym_tramp.S
new file mode 100644
index 0000000..48b9bdb
--- /dev/null
+++ b/source/kernel/infra/ksym_tramp.S
@@ -0,0 +1,302 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * 未导出函数符号的跳板：模块内对同名符号的调用落到这里，
+ * 再由 ksym.c 在 init 阶段填入的地址跳过去。br 是尾跳转，
+ * kCFI 只校验间接调用（blr），不校验 br，因此不需要类型 hash。
+ * 由 /tmp/gen_ksym.py 生成，勿手改。
+ */
+#include <linux/linkage.h>
+#include <linux/version.h>
+
+	.text
+SYM_FUNC_START(__arm64_sys_close)
+	adrp	x16, ksu_sym___arm64_sys_close
+	ldr	x16, [x16, :lo12:ksu_sym___arm64_sys_close]
+	br	x16
+SYM_FUNC_END(__arm64_sys_close)
+SYM_FUNC_START(__arm64_sys_setns)
+	adrp	x16, ksu_sym___arm64_sys_setns
+	ldr	x16, [x16, :lo12:ksu_sym___arm64_sys_setns]
+	br	x16
