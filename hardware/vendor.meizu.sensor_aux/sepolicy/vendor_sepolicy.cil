;; vendor.meizu.sensor_aux（ISensorAux 桩服务）的 SELinux 片段，由 07_build_vendor
;; 步骤 6 以 marker（;; cdh-patch-begin: vendor_sepolicy.cil@vendor.meizu.sensor_aux）
;; 整块并入装配树的 etc/selinux/vendor_sepolicy.cil。
;;
;; 为什么放模块层：服务名与「谁能看见它」是本 HAL 的契约，随模块复用；机型层只保留
;; 绑定本机启动链的事实。口径与 vendor.qti.hardware.perf2 一致（见 engine/evidence/
;; issue-m22-perf2-find-grant：那次把服务名标签从机型层迁到模块层，顺带把客户端
;; 授权改成只授 find）。
;;
;; 背景：Flyme 在 system_server 内 native getService(vendor.meizu.sensor_aux.
;; ISensorAux/default)，名字缺标签时整份 denied { find }（实例 30 里 46,600 条）。
;; 类型名用 hal_sensor_aux_service：与 AOSP hal_*_service 同风格，不带项目缩写。
(type hal_sensor_aux_service)
(roletype object_r hal_sensor_aux_service)
(typeattributeset service_manager_type (hal_sensor_aux_service))

;; 客户端：system_server 在 framework 内 native getService（只 find，不含 binder 调用）。
(allow system_server_{{vers}} hal_sensor_aux_service (service_manager (find)))
;; 服务端：本模块 rc 的 seclabel 是 u:r:hal_sensors_default:s0，以该域注册本名。
(allow hal_sensors_default hal_sensor_aux_service (service_manager (add find)))
