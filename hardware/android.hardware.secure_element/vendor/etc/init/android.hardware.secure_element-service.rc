# engine/vendor 自研 secure_element HAL（虚拟 HAL）：无真实安全单元，如实上报无卡。
#
# disabled + on post-fs-data 显式 start：该实例在 m22 官方/manifest 里只声明了
# SIM1/SIM2，eSE1 不在 FCM 声明内，没有组件在开机关键路径上等它；显式启动既保证
# /vendor 与 /dev/binder 就绪，又避开 class 批量启动窗口的失败重试。
# SELinux：复用底座标准域 hal_secure_element_default；
#   可执行标签由 07_build_vendor 步骤 6b 按本文件的 seclabel 自动补 _exec 规则。
service vendor.secure_element-default /vendor/bin/hw/android.hardware.secure_element-service
    class hal
    user system
    group system
    seclabel u:r:hal_secure_element_default:s0
    interface aidl android.hardware.secure_element.ISecureElement/eSE1
    disabled

on post-fs-data
    start vendor.secure_element-default
