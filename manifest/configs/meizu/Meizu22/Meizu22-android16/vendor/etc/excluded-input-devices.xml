<?xml version="1.0" encoding="utf-8"?>
<!--
  m22 云机的输入设备排除表（InputReader 读 /vendor/etc/excluded-input-devices.xml）。

  只排除 ACPI 电源键：QEMU 提供的 Power Button 对云机无用，留着只会在
  dumpsys input 里多一台 KEYBOARD 类设备。

  触摸设备**不能**排除。它的 guest 侧名字是 `fts`（device.json 的 `input.touch.name`，
  对齐魅族真机 ST FTS），`abs-to-mt=on` 让 QEMU 把单点 ABS 直接以 MT-B 上报，
  不依赖 idc（静态树里的 3 份 idc 已于 2026-10-29 删除，见 m22 README 与证据 #63）。
-->
<devices>
    <device name="Power Button"/>
</devices>
