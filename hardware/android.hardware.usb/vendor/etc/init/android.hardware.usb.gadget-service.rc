# engine/vendor 自研 usb gadget HAL（虚拟 HAL）：云机没有 gadget 控制器，服务注册
# android.hardware.usb.gadget.IUsbGadget/default，UsbGadget 按未连接降级。
service vendor.usb-gadget /vendor/bin/hw/android.hardware.usb.gadget-service
    class hal
    user root
    group root
    seclabel u:r:hal_usb_gadget_default:s0
    interface aidl android.hardware.usb.gadget.IUsbGadget/default
