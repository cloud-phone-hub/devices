;; RMX6688（realme GT7 / ColorOS 15.0.2 / mt6991 / plat 202404）机型层 SELinux 片段。

;; 1) init.virtio_compat.rc early-init 文件级 bind mount 所需权限
(allow init system_lib_file (file (mounton)))
(allow init vendor_configs_file (file (mounton)))
(allow init system_file (filesystem (mount)))
(allow init vendor_file (filesystem (mount)))

;; 2) Widevine AIDL HAL（hal_drm_widevine 域与服务注册）
(type hal_drm_widevine)
(roletype object_r hal_drm_widevine)
(type hal_drm_widevine_exec)
(roletype object_r hal_drm_widevine_exec)
(typeattributeset domain (hal_drm_widevine))
(typeattributeset halserverdomain (hal_drm_widevine))
(typeattributeset halclientdomain (hal_drm_widevine))
(typeattributeset hal_drm (hal_drm_widevine))
(typeattributeset hal_drm_server (hal_drm_widevine))
(typeattributeset hal_allocator_client (hal_drm_widevine))
(typeattributeset file_type (hal_drm_widevine_exec))
(typeattributeset exec_type (hal_drm_widevine_exec))
(typeattributeset vendor_file_type (hal_drm_widevine_exec))
(allow init_{{vers}} hal_drm_widevine_exec (file (read getattr map execute open)))
(allow init_{{vers}} hal_drm_widevine (process (transition siginh rlimitinh)))
(dontaudit init_{{vers}} hal_drm_widevine (process (noatsecure)))
(typetransition init_{{vers}} hal_drm_widevine_exec process hal_drm_widevine)
(allow hal_drm_widevine hal_drm_widevine_exec (file (read getattr map execute open entrypoint)))
(allow hal_drm_widevine vendor_file_{{vers}} (file (read getattr map open)))
(allow hal_drm_widevine vndbinder_device_{{vers}} (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(allow hal_drm_widevine vndservicemanager_{{vers}} (binder (call transfer)))
(allow vndservicemanager_{{vers}} hal_drm_widevine (dir (search)))
(allow vndservicemanager_{{vers}} hal_drm_widevine (file (read map open)))
(allow vndservicemanager_{{vers}} hal_drm_widevine (process (getattr)))
(allow hal_drm_widevine servicemanager_{{vers}} (binder (call transfer)))
(allow hal_drm_widevine hal_drm_service_{{vers}} (service_manager (add find)))
(allow hal_drm_widevine mediaserver_service_{{vers}} (service_manager (add find)))
(allow hal_drm_widevine default_android_service_{{vers}} (service_manager (add find)))
(allow hal_drm_widevine pioneer (binder (call transfer)))
(allow pioneer hal_drm_widevine (binder (call transfer)))
(allow hal_drm_widevine hal_allocator_server (fd (use)))
(allow hal_drm_widevine mediacodec (fd (use)))
(allow hal_drm_widevine vendor_data_file_{{vers}} (dir (ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow hal_drm_widevine vendor_data_file_{{vers}} (file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
(allow hal_drm_widevine debugfs_tracing_{{vers}} (file (write)))
(allow hal_drm_widevine mnt_vendor_file_{{vers}} (dir (search)))
(allow hal_drm_widevine block_device_{{vers}} (dir (search)))

;; 3) crash_dump / surfaceflinger 宽松模式（对齐 Android 15 22.2 基线）
(typepermissive crash_dump)
(typepermissive surfaceflinger)

;; 4) FRP 承载块设备（/dev/block/by-name/frp -> /dev/block/vda3）
(allow system_server_{{vers}} misc_block_device_{{vers}} (blk_file (open read write append getattr ioctl map lock)))

;; 5) 官方 system_ext_property_contexts 跨区引用的两项厂商属性类型（缺则二阶段 PropertyInit setxattr EINVAL 重启）
(type vendor_engineer_prop)
(roletype object_r vendor_engineer_prop)
(typeattributeset property_type (vendor_engineer_prop))
(typeattributeset vendor_property_type (vendor_engineer_prop))
(typeattributeset vendor_restricted_property_type (vendor_engineer_prop))
(allow init_{{vers}} vendor_engineer_prop (file (read getattr map open)))
(allow system_app_{{vers}} vendor_engineer_prop (file (read getattr map open)))
(allow system_server_{{vers}} vendor_engineer_prop (file (read getattr map open)))

(type vendor_oplus_prop)
(roletype object_r vendor_oplus_prop)
(typeattributeset property_type (vendor_oplus_prop))
(typeattributeset vendor_property_type (vendor_oplus_prop))
(typeattributeset vendor_restricted_property_type (vendor_oplus_prop))
(allow domain vendor_oplus_prop (file (read getattr map open)))
(allow vendor_init_{{vers}} vendor_oplus_prop (file (read getattr map open)))
(allow vendor_init_{{vers}} vendor_oplus_prop (property_service (set)))

;; 6) 官方 system_ext_seapp_contexts 跨区引用的相机应用数据目录类型（缺则 installd/zygote 建目录设标失败）
(type opluscamera_app_data_file)
(roletype object_r opluscamera_app_data_file)
(typeattributeset file_type (opluscamera_app_data_file))
(typeattributeset data_file_type (opluscamera_app_data_file))
(typeattributeset core_data_file_type (opluscamera_app_data_file))
(typeattributeset app_data_file_type (opluscamera_app_data_file))
(allow opluscamera_app_{{vers}} opluscamera_app_data_file (dir (ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow opluscamera_app_{{vers}} opluscamera_app_data_file (file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
(allow isolated_app_{{vers}} opluscamera_app_data_file (file (read write)))
(allow mediaserver_{{vers}} opluscamera_app_data_file (file (read write)))
(allow priv_app_{{vers}} opluscamera_app_data_file (file (read getattr open)))

;; 7) OPPO/realme 显示色彩扩展 AIDL（IDisplayColorFeature/default，由 hwc3-service.drm 同进程承载）
(typeattributeset hal_displaycolorfeature (hal_graphics_composer_default))
(typeattributeset hal_displaycolorfeature_client (surfaceflinger_{{vers}}))
(typeattributeset hal_displaycolorfeature_server (hal_graphics_composer_default))
(allow hal_displaycolorfeature_client hal_displaycolorfeature_server (binder (call transfer)))
(allow hal_displaycolorfeature_server hal_displaycolorfeature_client (binder (transfer)))
(allow hal_displaycolorfeature_client hal_displaycolorfeature_server (fd (use)))

;; 8) OPPO/realme 充电管理扩展 AIDL（ICharger/default，由 android.hardware.health-service 同进程承载）
(typeattributeset hal_charger (hal_health_default))
(typeattributeset hal_charger_server (hal_health_default))
(typeattributeset hal_charger_client (system_server_{{vers}} system_app_{{vers}} platform_app_{{vers}}))
(allow hal_charger_server hal_charger_service (service_manager (add find)))
(allow hal_charger_client hal_charger_server (binder (call transfer)))
(allow hal_charger_server hal_charger_client (binder (transfer)))
(allow hal_charger_client hal_charger_server (fd (use)))
