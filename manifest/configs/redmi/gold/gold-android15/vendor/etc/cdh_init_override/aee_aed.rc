service aee_aed /system/bin/sleep 2147483647
    class main
    user root
    group root system log
    seclabel u:r:pioneer:s0

service aee-reinit /system/bin/true
    class main
    oneshot
    user root
    group root
    seclabel u:r:pioneer:s0

service anrdump /system/bin/true
    oneshot
    disabled
    user root
    group root
    seclabel u:r:pioneer:s0

service aee_set_md_ver_prop /system/bin/true
    oneshot
    disabled
    user root
    group root
    seclabel u:r:pioneer:s0

service aee_callback /system/bin/true
    oneshot
    disabled
    user root
    group root
    seclabel u:r:pioneer:s0

service aeedump /system/bin/true
    oneshot
    disabled
    user root
    group root
    seclabel u:r:pioneer:s0
