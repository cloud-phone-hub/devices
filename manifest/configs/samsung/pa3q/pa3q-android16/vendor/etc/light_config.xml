<?xml version="1.0" encoding="utf-8"?>
<!--
  ss9380（Samsung Galaxy S25 Ultra）lights 灯清单（设备独有，随机型 vendor 镜像下发）。

  本 HAL 是虚拟 lights HAL：颜色/闪烁模式只记录、不驱动硬件，灯清单决定 framework
  LightsService 能枚举出哪些灯（getLights 的返回值）。改清单不需要重编 HAL。

  取值来源：官方 `/vendor/bin/hw/android.hardware.lights-service.samsung` 的 strings 里
  只有三类背光 sysfs：
    /sys/class/backlight/{lcd-bl,panel0-backlight,panel}/brightness  → BACKLIGHT
    /sys/class/leds/button-backlight/brightness                      → BUTTONS
    /sys/class/leds/touchkey-led/brightness + touchkey-led 路径      → KEYBOARD
  S25 Ultra 已取消通知灯（无 lcd_notify / led_notify 路径），故**不报**
  NOTIFICATIONS / BATTERY / ATTENTION / BLUETOOTH / WIFI / MICROPHONE / CAMERA
  （m22 那份 9 灯清单是 QTI 参考实现的 strings，不适用于本机型）。
    id      = getLights 返回的 id（任意但需唯一）
    ordinal = 同类型灯的序号（同 type 多灯时区分；本机单一灯/类型，全 0）
    type    = BACKLIGHT / KEYBOARD / BUTTONS / BATTERY / NOTIFICATIONS / ATTENTION /
              BLUETOOTH / WIFI / MICROPHONE / CAMERA
-->
<lights-config>
    <light id="0" ordinal="0" type="BACKLIGHT"/>
    <light id="1" ordinal="0" type="BUTTONS"/>
    <light id="2" ordinal="0" type="KEYBOARD"/>
</lights-config>
