    color_magenta_sdr = /odm/etc/camera/LUT_17/color_magenta_SRGB.cube
    color_warm_cyan_sdr = /odm/etc/camera/LUT_17/color_warm_cyan_SRGB.cube

    color_base_hdr = /odm/etc/camera/LUT_17/color_base_HLG.cube
    color_cold_cyan_hdr = /odm/etc/camera/LUT_17/color_cold_cyan_HLG.cube
    color_cyan_hdr = /odm/etc/camera/LUT_17/color_cyan_HLG.cube
    color_warm_hdr = /odm/etc/camera/LUT_17/color_warm_HLG.cube
    color_warm_magenta_hdr = /odm/etc/camera/LUT_17/color_warm_magenta_HLG.cube
