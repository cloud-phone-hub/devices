diff --git a/source/kernel/include/infra/ksym.h b/source/kernel/include/infra/ksym.h
new file mode 100644
index 0000000..72ab0ba
--- /dev/null
+++ b/source/kernel/include/infra/ksym.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * 未导出内核符号的运行时接入层（外部模块形态）。
+ *
+ * 内核没有 EXPORT_SYMBOL 的符号，普通 insmod 会在 simplify_symbols() 阶段报
+ * "Unknown symbol" 并导致装载失败；这里沿用 cdh_redirect 的思路：只用导出 API
+ * （register_kprobe 是导出的），在模块 init 最早阶段把符号解析成地址，
+ * 再让模块内部引用落到本地 trampoline / 指针上：
+ *
+ *  - 函数符号 -> infra/ksym_tramp.S 里同名的 4 条指令跳板（br 到真实地址）
+ *  - 数据符号 -> 下面的宏，解引用到真实地址（本文件须在使用处的内核头之后包含）
+ *
+ * 两个例外（宏在头文件里的 inline 函数就被引用，宏换不到）：
+ *  - selinux_blob_sizes：ksym.c 里定义同名变量，init 时从真实地址快照一份
+ *    （LSM blob 大小在 init 之后不再变，快照语义等价）；
+ *  - __tracepoint_sys_enter：注册处改用 tracepoint_probe_register* 直接拿指针，
+ *    不再走 register_trace_sys_enter() 这类头内 inline。
+ */
+#ifndef __KSU_INFRA_KSYM_H
+#define __KSU_INFRA_KSYM_H
+
+#include <linux/types.h>
+
+/* 由 infra/ksym.c 在模块 init 最早阶段填充；返回 0 表示全部解析成功。 */
+int ksu_ksym_init(void);
+
+extern void *ksu_sym___tracepoint_sys_enter;
+extern void *ksu_sym_init_mm;
+extern void *ksu_sym_mntns_operations;
+extern void *ksu_sym_selinux_blob_sizes;
+extern void *ksu_sym_selinux_state;
+
+#define __tracepoint_sys_enter (*((struct tracepoint *)ksu_sym___tracepoint_sys_enter))
+#define init_mm (*((struct mm_struct *)ksu_sym_init_mm))
+#define mntns_operations (*((const struct proc_ns_operations *)ksu_sym_mntns_operations))
+#define selinux_state (*((struct selinux_state *)ksu_sym_selinux_state))
+
+#endif /* __KSU_INFRA_KSYM_H */
