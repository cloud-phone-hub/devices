[FeatureTouchAFForThirdCam]
    #key                                               value
    com.whatsapp                                  =     1;

[FeatureTouchAEForThirdCam]
    #key                                               value
    com.mt.mtxx.mtxx                              =     1;
    com.meitu.meiyancamera                        =     1;

[FeatureFallbackForThirdCam]
    #key                                               value
    App[0] = defaultApp

[FeatureVainrForThirdCam]
    #key                                                                              value
    com.tencent.mm.ui.LauncherUI[1]                                                  =     true;
    com.tencent.mm.plugin.voip.ui.VideoActivity[1]                                   =     true;

[FeatureVideoMcs]
    otpSize        = 20;
    dataVersion    = 105;

    #Mcs algo config
    maxLineCount   = 8400;
    tLine          = 22.8;
    rangeLow       = 200.0;
    rangeHigh      = 300.0;
    DCGsWitch      = 1;
    fixExpRatio    = 16.0;

    #video Mcs config
    mcsVideoEnable = 1;
    width          = 1024;
    height         = 768;
    channel        = 1;
    mirror         = 3;
    region_mode    = 2;
    OplusIsEnableCsExif = true;
    mcsVideoMode   = 0x800B; 0x8021; 0x8028; 0x80A7;

    #power Mcs config
    MCSHighTempThreshold = 45;
    MCSHighTempResumeThreshold = 43;

